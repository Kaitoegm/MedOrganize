{"nodes": [{"id": "docs_plano_ferramentas_mednotes_tools_plan", "label": "MedNotes Ferramentas de Desenho Plan", "file_type": "document", "source_file": "docs/plano_ferramentas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plano_ferramentas_toolsettings_state_model", "label": "toolSettings Per-Tool State Map", "file_type": "rationale", "source_file": "docs/plano_ferramentas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the global penColor/penSize/penOpacity variables with a per-tool settings map so pen and highlighter no longer share state and each tool remembers its own config; referenced at notes.js:1162."}, {"id": "docs_plano_ferramentas_brushtype_stroke_model", "label": "brushType Stroke Rendering Model", "file_type": "rationale", "source_file": "docs/plano_ferramentas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds brushType to serialized strokes and dispatches rendering per type (ballpoint, fountain pen via pressure+velocity, pencil texture, fineliner, round/chisel highlighter, auto-straight-line) so mouse users get visually distinct pens without needing an S-Pen; old strokes default to ballpoint for backward compatibility."}, {"id": "docs_plano_ferramentas_rich_popovers", "label": "Rich Tool Popovers (replace corner pickers)", "file_type": "rationale", "source_file": "docs/plano_ferramentas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves color/size/type pickers from the top-right toolbar corner into per-tool popovers opened by clicking the active tool, reusing existing _togglePopover positioning logic; referenced at notes.js:1072."}, {"id": "docs_plano_ferramentas_ruler_fix", "label": "R\u00e9gua (Ruler) Visibility + Snap Fix", "file_type": "rationale", "source_file": "docs/plano_ferramentas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Root cause: ruler only draws when _ruler.active, which is only set by clicking it while invisible (deadlock). Fix initializes ruler at viewport center on activation and projects strokes onto the ruler line for snap; referenced at notes.js:2263."}, {"id": "docs_plano_ferramentas_text_tool_fix", "label": "Texto (Text Tool) Editable + Persisted Fix", "file_type": "rationale", "source_file": "docs/plano_ferramentas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Root cause: .canvas-text-element div has no CSS and no position, and canvas-ui layer blocks clicks; it isn't persisted. Fix creates the box inside #text-overlays, adds real CSS, persists via page.textElements[], and suspends canvas-ui pointer-capture while editing; referenced at notes.js:2439."}, {"id": "docs_plano_ferramentas_persistence_extension", "label": "Extended Persistence (Strokes + Texts)", "file_type": "rationale", "source_file": "docs/plano_ferramentas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "_savePage and loadActivePage currently only handle strokes; must be extended to also serialize/restore page.textElements[] so text boxes persist across sessions."}, {"id": "docs_plano_ferramentas_execution_phases", "label": "Fases de Execu\u00e7\u00e3o A-D", "file_type": "rationale", "source_file": "docs/plano_ferramentas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered, independently testable phases: A) foundation (toolSettings + rich popovers), B) brush types, C) ruler, D) text \u2014 each verifiable in the browser via server.py before moving to the next."}], "edges": [{"source": "docs_plano_ferramentas_mednotes